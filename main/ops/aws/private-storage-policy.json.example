{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_BUCKET"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::REPLACE_PRIVATE_BUCKET/instructor-credentials/*", "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/contributor-credentials/*"]
    }
  ]
}
