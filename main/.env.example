APP_NAME=Kody
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
HASH_DRIVER=argon2id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kody
DB_USERNAME=kody
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
# Production RDS: verify-full with the current AWS RDS CA bundle.
# DB_SSLROOTCERT=/path/to/rds-ca-bundle.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true in staging/production (HTTPS).

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Verification email uses SMTP, never the log mailer. Configure a local mail catcher.
ACCOUNT_VERIFICATION_MAILER=smtp
ACCOUNT_VERIFICATION_EXPIRES_MINUTES=60
ACCOUNT_RECOVERY_MAILER=smtp
ACCOUNT_RECOVERY_EXPIRES_MINUTES=60
ACCOUNT_RECOVERY_COOLDOWN_SECONDS=60
ACCOUNT_RECOVERY_REQUESTS_PER_HOUR=5
INSTRUCTOR_CREDENTIAL_DISK=local
INSTRUCTOR_CREDENTIAL_MAX_KILOBYTES=5120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
