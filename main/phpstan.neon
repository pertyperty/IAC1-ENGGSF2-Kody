includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app/Http/Controllers/NotificationController.php
        - app/Http/Controllers/Learning/BookmarkController.php
        - app/Http/Controllers/Learning/ReviewQueueController.php
        - app/Http/Controllers/HelpController.php
        - app/Http/Controllers/Administration/FaqController.php
        - app/Http/Controllers/Content/CourseLearningController.php
        - app/Enums
        - app/Policies
        - app/Services/Operations
        - app/Jobs/Operations
        - app/Console/Commands/QueueCoverage.php
        - app/Console/Commands/OperationsHeartbeat.php
        - app/Http/Middleware/TrustConfiguredProxies.php
        - app/Services/Account/CredentialDocuments.php
        - app/Services/Administration/ReviewInbox.php
        - app/Services/Administration/ReportFinancials.php
        - app/Http/Controllers/Administration/ReviewInboxController.php
        - app/Http/Controllers/Challenges/PublishedChallengeController.php
        - app/Http/Controllers/Challenges/WeeklyChallengeController.php
        - app/Models/WeeklyEvent.php
        - app/Support/RegistrationTerms.php
        - app/Actions/Account/RegisterAccount.php
        - app/Services/Games/PracticeChallenges.php
        - app/Services/Games/AssessmentChallenges.php
        - app/Services/Games/GameAssessment.php
        - app/Services/Games/ArcadeGames.php
        - app/Services/Games/CommandGarden.php
    tmpDir: storage/framework/cache/phpstan
    checkModelProperties: true
    # Enum/date casts live in model casts() methods, not constant PHPDoc shapes.
    parseModelCastsMethod: true
    parallel:
        maximumNumberOfProcesses: 2
